{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=./data/device-diagnostics.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "DeviceDiagnostics",
    "Audience": "DeviceDiagnostics",
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "ExpiresMinutes": 60
  },
  "AllowedHosts": "*"
}
